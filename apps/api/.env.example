# apps/api/.env.example
# Copy to apps/api/.env for local development (already git-ignored).
# Values here match infra/docker-compose.yml defaults — no changes needed for local dev.

# --- App ---
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

# --- Database (Postgres + pgvector, via infra/docker-compose.yml) ---
DATABASE_URL="postgresql://parallel:parallel_dev_password@localhost:5432/parallel_dev?schema=public"

# --- Redis (via infra/docker-compose.yml) ---
REDIS_URL="redis://localhost:6379"

# --- Auth ---
JWT_SECRET="replace-with-a-long-random-string-before-anything-real-touches-this"
JWT_EXPIRES_IN="7d"

# --- AI (Phase 6/9 — Identity Engine, Quest generation, Wrapped copy) ---
ANTHROPIC_API_KEY=""
EMBEDDING_API_KEY=""

# --- Object storage / CDN (Phase 9 — Identity Cards, Wrapped assets) ---
OBJECT_STORAGE_BUCKET=""
OBJECT_STORAGE_REGION=""
OBJECT_STORAGE_ACCESS_KEY_ID=""
OBJECT_STORAGE_SECRET_ACCESS_KEY=""
CDN_BASE_URL=""
